PYTEST_RUNNING=1

# DB
DATABASE_URL=sqlite+aiosqlite:///./test.db
#DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/test_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
USER_JWT_SECRET=XXXXX
ADMIN_JWT_SECRET=XXXXX

# Sessions
USER_SESSION_EXPIRE_SECONDS=3600
ADMIN_SESSION_EXPIRE_SECONDS=600

# Discounts
DISCOUNT_TTL_SECONDS=300
NTH_ORDER=5

# Admin login
ADMIN_USERNAME=XXXXX
ADMIN_PASSWORD=XXXXX
ADMIN_PASSWORD_HASH=XXXXX

# Admin API key
ADMIN_API_KEY=XXXXX

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logs
LOG_FILE=test.log
