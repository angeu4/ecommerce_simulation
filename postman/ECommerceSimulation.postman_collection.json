				{
					"name": "User Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 or 201\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"",
									"try {",
									"    var body = pm.response.json();",
									"    if (body.id) {",
									"        pm.environment.set(\"userId\", body.id.toString());",
									"        console.log(\"Set userId =>\", body.id);",
									"    } else {",
									"        console.log(\"No id in register response\", body);",
									"    }",
									"} catch (e) {",
									"    console.log(\"Could not parse register response as JSON\", e);",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"user3\",\n  \"password\": \"pass125\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users"
							]
						}
					},
					"response": []
				},
